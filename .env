# Server
NODE_ENV=development
PORT=5000
APP_NAME=RealEstate
FRONTEND_URL=http://localhost:5173

# Database (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=realestate_db
DB_CONNECTION_LIMIT=10

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=realestate
REDIS_ENABLED=false

# Mongo
MONGO_URI=mongodb://localhost:27017/realestate_logs
MONGO_ENABLED=false

# JWT (16+ chars required)
JWT_ACCESS_SECRET=dev_access_secret_change_in_prod_64chars_minimum_xxxxxxxxxxx
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev_refresh_secret_change_in_prod_64chars_minimum_xxxxxxxxxx
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# Legacy (kept for old controllers during transition)
JWT_SECRET=dev_legacy_secret_change_in_prod
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,application/pdf