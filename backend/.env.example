PORT=5001
FRONTEND_URL=http://localhost:3000

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=realestate_db

JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
NODE_ENV=development

# Optional MongoDB support. Leave empty to run with SQL fallback only.
MONGO_URI=
MONGO_CONNECT_TIMEOUT_MS=2500
MONGO_ARCHIVE_ENABLED=false
MONGO_ARCHIVE_CRON=0 3 * * *
MONGO_ARCHIVE_BATCH_SIZE=500
MONGO_MESSAGE_ARCHIVE_DAYS=90
MONGO_AUDIT_ARCHIVE_DAYS=180

# Optional Stripe webhook support. Leave empty for safe webhook failure.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
