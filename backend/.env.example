# Server
NODE_ENV=development
PORT=5000
APP_NAME=RealEstate
FRONTEND_URL=http://localhost:5173
SOCKET_PATH=/socket.io

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=realestate_db
DB_CONNECTION_LIMIT=10

# Redis (optional during dev; set REDIS_ENABLED=true to use)
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=realestate
REDIS_ENABLED=false

# MongoDB (optional during dev; set MONGO_ENABLED=true to use)
MONGO_URI=mongodb://localhost:27017/realestate_logs
MONGO_ENABLED=false

# JWT
JWT_ACCESS_SECRET=change_me_to_64_random_chars_change_me_to_64_random_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=different_64_random_chars_different_64_random_chars_xx
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,application/pdf

# Email (for password reset, notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="RealEstate <noreply@realestate.local>"

